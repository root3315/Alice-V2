# ── claude-proxy ──
# ВАЖНО: ANTHROPIC_API_KEY НЕ задаём — тогда claude CLI идёт через OAuth Max-подписки.
# Если задать ключ, CLI уйдёт на платный API (другой кошелёк) — нам это не нужно.

# Модель по умолчанию (sonnet / haiku / opus). Быстрая = haiku, баланс = sonnet.
PROXY_DEFAULT_MODEL=sonnet

# Автофолбэк при перегрузе основной модели (опционально), напр. sonnet.
PROXY_FALLBACK_MODEL=

# Сколько параллельных вызовов claude разрешаем (каждый — отдельный процесс).
PROXY_MAX_CONCURRENCY=6

# Таймаут одного вызова, сек.
PROXY_TIMEOUT_S=180

# Явный путь к claude, если автопоиск не сработал.
# PROXY_CLAUDE_CLI=C:\Users\sozda\.local\bin\claude.exe

# Уровень логов прокси.
PROXY_LOG=INFO
