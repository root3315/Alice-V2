# Конфиг TTS-шима (start-tts.ps1 читает .env-tts). Скопируй в .env-tts и правь.
# Без .env-tts шим работает на дефолтах: движок xtts, голос "Tammie Ema".

# Движок: xtts (живой голос на GPU) | edge (Microsoft нейронный) | gtts (запасной)
TTS_PROXY_ENGINE=xtts

# ── XTTS-v2 ──────────────────────────────────────────────────────────────────
# Встроенный голос. Полный список: GET http://127.0.0.1:5123/voices
# или `python xtts_voices.py`. Образцы: `python xtts_voices.py --sample`.
XTTS_SPEAKER=Tammie Ema

# Клонирование своего голоса: путь к WAV 6-30с чистой речи. Если задан —
# перебивает XTTS_SPEAKER (Алиса заговорит этим голосом).
# XTTS_SPEAKER_WAV=C:\Users\sozda\Desktop\my-voice.wav

# Язык синтеза (ru/en/...). По умолчанию ru.
XTTS_LANG=ru

# Устройство: cuda (GPU, быстро) | cpu (медленно, если нет GPU)
XTTS_DEVICE=cuda

# ── edge-tts (используется как фолбэк или при TTS_PROXY_ENGINE=edge) ──────────
# TTS_PROXY_VOICE=ru-RU-SvetlanaNeural
# TTS_PROXY_RATE=+0%
# TTS_PROXY_PITCH=+15Hz

# ── Whisper / ASR (слух Алисы; читается и start-asr.ps1) ──────────────────────
# WHISPER_MODEL=large-v3        # large-v3 = лучшее качество для русского | medium | small
# WHISPER_DEVICE=cuda           # cuda (GPU) | cpu
# WHISPER_COMPUTE=int8_float16  # cuda: int8_float16 / float16; cpu: int8
# WHISPER_LANG=ru               # "" = автоопределение языка
